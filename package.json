{
  "name": "dsh-agent-message",
  "version": "1.6.0",
  "packageManager": "pnpm@11.1.1",
  "description": "跨会话 Agent 通信：让 DeepSeek Harness 里不同的 Agent 会话互相收发消息。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "agent",
    "multi-agent",
    "messaging"
  ],
  "homepage": "https://github.com/GengDaPeng/dsh-agent-message#readme",
  "bugs": {
    "url": "https://github.com/GengDaPeng/dsh-agent-message/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GengDaPeng/dsh-agent-message.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "test": "node --test",
    "test:web-smoke": "node scripts/web-smoke.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/assets/message-header-navigation.jpg",
    "NOTICE.md",
    "docs/validation-0.2.0-rc.2.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "list_peer_agents",
        "send_agent_message",
        "check_delivery"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2"
  },
  "engines": {
    "node": ">=24 <25",
    "dsh": "0.2.0-rc.2"
  },
  "license": "MIT"
}
